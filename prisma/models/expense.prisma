model ExpenseRecurrence {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  name              String              @db.VarChar(150)
  amount            Int
  frequency         RecurrenceFrequency
  dueDay            Int                 @map("due_day")
  plannedPaymentDay Int?                @map("planned_payment_day")
  startCompetence   DateTime            @map("start_competence") @db.Date
  endCompetence     DateTime?           @map("end_competence") @db.Date
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
  @@map("expense_recurrences")
}

model InstallmentPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  name                 String   @db.VarChar(150)
  totalAmount          Int      @map("total_amount")
  installments         Int
  purchaseDate         DateTime @map("purchase_date") @db.Date
  firstInstallmentDate DateTime @map("first_installment_date") @db.Date
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
  @@map("installment_plans")
}

model Expense {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  recurrenceId       String?   @map("recurrence_id") @db.Uuid
  installmentPlanId  String?   @map("installment_plan_id") @db.Uuid
  installmentNumber  Int?      @map("installment_number")
  name               String    @db.VarChar(150)
  amount             Int
  competence         DateTime  @db.Date
  dueDate            DateTime  @map("due_date") @db.Date
  plannedPaymentDate DateTime? @map("planned_payment_date") @db.Date
  paidDate           DateTime? @map("paid_date") @db.Date
  paidAmount         Int?      @map("paid_amount")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrence      ExpenseRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@unique([recurrenceId, competence])
  @@index([userId, competence])
  @@index([userId, dueDate])
  @@index([recurrenceId])
  @@index([installmentPlanId])
  @@map("expenses")
}